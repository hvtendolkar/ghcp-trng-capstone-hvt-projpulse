# Environment variables for backend

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/projectpulse
# Or use this for production:
# DATABASE_URL=postgresql://user:password@prod-db-host:5432/projectpulse

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
PROJECT_NAME=ProjectPulse AI
VERSION=1.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# AI/Gemma
GEMMA_API_KEY=your-gemma-api-key-here
GEMMA_MODEL=gemma-2b
